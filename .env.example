ANTHROPIC_API_KEY=
# OpenAI API key (optional). Leave blank to disable the OpenAI provider.
# When blank, Jarvis uses only Claude for AI completions.
OPENAI_API_KEY=
# Google Gemini API key (optional). Leave blank to disable the Gemini provider.
# When blank, Jarvis routes to the next available provider.
GOOGLE_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=4096
# AI reasoning is off by default; Jarvis runs fully rule-based with no AI calls.
AI_REASONING_ENABLED=false
DATABASE_PATH=data/jarvis.db
LOG_LEVEL=INFO
APPROVAL_TIMEOUT_SECONDS=60
DEBUG=false

# Voice output (Phase 41) - off by default. VOICE_PROVIDER=fake only
# constructs a silent, audio-free test provider; there is no real
# text-to-speech engine yet. Accepted values: VOICE_SPEAK_MODE=off/all,
# VOICE_PROVIDER=none/fake.
VOICE_ENABLED=false
VOICE_SPEAK_MODE=off
VOICE_PROVIDER=none

# Voice input (Phase 41) - off by default. VOICE_INPUT_PROVIDER=fake only
# constructs a silent, microphone-free test provider; there is no real
# speech-to-text engine or microphone access yet. Accepted values:
# VOICE_INPUT_PROVIDER=none/fake.
VOICE_INPUT_ENABLED=false
VOICE_INPUT_PROVIDER=none